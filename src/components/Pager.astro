---
const { page, pages } = Astro.props;
const url = (n: number) => n === 1 ? '/articles/' : `/articles/page/${n}/`;
---
{pages > 1 && <nav class="pager" aria-label="ページ送り">
{page > 1 ? <a href={url(page - 1)} rel="prev">← 前へ</a> : <span aria-hidden="true"></span>}
<ol>{Array.from({ length: pages }, (_, i) => i + 1).map(n => <li>{n === page ? <span aria-current="page">{n}</span> : <a href={url(n)}>{n}</a>}</li>)}</ol>
{page < pages ? <a href={url(page + 1)} rel="next">次へ →</a> : <span aria-hidden="true"></span>}
</nav>}
