---
import { coverVariants } from '../lib/content';
const { article, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const v = coverVariants(article.meta.cover);
const href = `/articles/${article.slug}/`;
---
<article class="card">
<a class="card-media" href={href} tabindex="-1" aria-hidden="true">
{v ? <img src={v.small ?? v.src} srcset={v.small ? `${v.small} 600w, ${v.src} 1200w` : undefined} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1023px) 46vw, 360px" width="1200" height="630" alt="" loading="lazy" decoding="async" />
 : <span class="text-cover" style={`--cover:${article.category.color}`}><span class="text-cover-cat">{article.category.short} / GUIDE</span><span class="text-cover-word">{article.meta.coverLabel}</span><span class="text-cover-brand">OCHA NOTE</span></span>}
</a>
<p class="meta"><span>{article.category.name}</span><span aria-hidden="true">/</span><span>{article.meta.kind}</span>{article.meta.affiliate && <span class="pr-label">PR</span>}</p>
<H class="card-title"><a href={href}>{article.meta.title}</a></H>
<p class="card-desc">{article.meta.description}</p>
</article>
