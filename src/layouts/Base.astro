---
import '../styles/global.css';
import { activeCategories } from '../lib/content';
interface Props { title?: string; description?: string; current?: string; noindex?: boolean; image?: string; type?: 'website' | 'article'; }
const { title, description = 'ガジェット、AI、お土産、家具、道具。毎日の暮らしで使うものを、使う場面から選ぶためのガイド。', current, noindex = false, image, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | OCHA NOTE` : 'OCHA NOTE（お茶ノート）— 毎日使うものを、ゆっくり選ぶ。';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// 表紙画像がないページは、サイト共通の画像をシェア時に使う
const ogImage = Astro.site ? new URL(image ?? '/og-default.jpg', Astro.site) : undefined;
const isPreview = import.meta.env.CF_PAGES_BRANCH && import.meta.env.CF_PAGES_BRANCH !== 'main';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title><meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{(noindex || isPreview) && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content={type} /><meta property="og:locale" content="ja_JP" />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content={image ? '630' : '628'} /><meta name="twitter:card" content="summary_large_image" /></>}
<meta property="og:site_name" content="OCHA NOTE" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><meta name="theme-color" content="#F6F2EA" />
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">本文へ移動</a>
<div class="strap">お茶を一杯飲むあいだに読める、ものの選び方</div>
<div class="wrap">
<header class="head">
<a class="logo" href="/" aria-label="OCHA NOTE ホーム">OCHA NOTE<span>.</span></a>
<p class="tag">毎日使うものを、ゆっくり選ぶ。</p>
</header>
<nav class="nav" aria-label="メインメニュー">
<a href="/articles/" aria-current={current === 'all' ? 'page' : undefined}>すべての記事</a>
{activeCategories.map(c => <a href={`/category/${c.id}/`} aria-current={current === c.id ? 'page' : undefined}>{c.name}</a>)}
</nav>
</div>
<main id="main"><slot /></main>
<footer class="footer"><div class="wrap">
<a class="footer-logo" href="/">OCHA NOTE<span>.</span></a>
<p>必要な機能を知って、納得して選ぶ。</p>
<ul class="footer-links"><li><a href="/articles/">すべての記事</a></li><li><a href="/about/">このサイトについて・編集方針</a></li><li><a href="/privacy/">プライバシーポリシー・免責事項</a></li></ul>
<p class="footer-note">Amazonのアソシエイトとして、OCHA NOTEは適格販売により収入を得ています。</p>
<small>© {new Date().getFullYear()} OCHA NOTE</small>
</div></footer>
</body></html>
