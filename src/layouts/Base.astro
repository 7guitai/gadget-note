---
import '../styles/global.css';
import { categories } from '../lib/content';
interface Props { title?: string; description?: string; current?: string; noindex?: boolean; }
const { title, description = 'ガジェット、お土産、家具、道具。毎日の暮らしで使うものを、使う場面から選ぶためのガイド。', current, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | OCHA NOTE` : 'OCHA NOTE（お茶ノート）— 毎日使うものを、ゆっくり選ぶ。';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const isPreview = import.meta.env.CF_PAGES_BRANCH && import.meta.env.CF_PAGES_BRANCH !== 'main';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title><meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{(noindex || isPreview) && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" />
{canonical && <meta property="og:url" content={canonical} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><meta name="theme-color" content="#3d6b35" />
</head>
<body>
<a class="skip" href="#main">本文へ移動</a>
<div class="topline"><div class="container">お茶を一杯飲むあいだに読める、ものの選び方</div></div>
<header class="header container">
<a class="brand" href="/" aria-label="OCHA NOTE ホーム"><span class="brand-mark">O<span>.</span></span><span>OCHA<br />NOTE<span class="brand-dot">.</span></span></a>
<p class="header-caption">毎日使うものを、<br />ゆっくり選ぶ。</p>
</header>
<div class="nav-wrap"><nav class="container nav" aria-label="メインメニュー">
<a href="/" aria-current={current === 'home' ? 'page' : undefined}>すべての記事</a>
{categories.map(c => <a href={`/category/${c.id}/`} aria-current={current === c.id ? 'page' : undefined}>{c.name}</a>)}
</nav></div>
<main id="main"><slot /></main>
<footer class="footer"><div class="container footer-inner"><div><a class="footer-brand" href="/">OCHA NOTE<span>.</span></a><p>必要な機能を知って、納得して選ぶ。</p></div><a href="/about/">このサイトについて・編集方針</a><small>© {new Date().getFullYear()} OCHA NOTE</small></div></footer>
</body></html>
