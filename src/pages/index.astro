---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, categories } from '../lib/content';
const latest = articles.slice(0, 6);
const count = (id: string) => articles.filter(a => a.meta.category === id).length;
---
<Base current="home">
<link slot="head" rel="preload" as="image" href="/hero-editorial-1600.webp" media="(min-width: 761px)" fetchpriority="high" />
<div class="wrap">
<section class="hero">
<picture><source media="(max-width: 760px)" srcset="/hero-editorial-900.webp" width="900" height="473" /><img class="hero-photo" src="/hero-editorial-1600.webp" width="1600" height="841" alt="" fetchpriority="high" /></picture>
<div class="hero-copy">
<p class="kicker">A LITTLE NOTE FOR YOUR EVERYDAY</p>
<h1>毎日使うものを、<br />ひと息ついて選ぶ。</h1>
<p>ガジェットも、AIも、暮らしの道具も。<br />使う場面から、ちょうどいいものを。</p>
<a class="button" href="#latest">選び方のノートを読む <span aria-hidden="true">→</span></a>
</div>
</section>

<section class="section" aria-labelledby="explore">
<div class="section-title"><div><p class="kicker">EXPLORE</p><h2 id="explore">気になるテーマから</h2></div></div>
<ul class="topics">{categories.map(c => <li><a class="topic" href={`/category/${c.id}/`}><strong>{c.name} <span aria-hidden="true">↗</span></strong><span>{c.desc}</span><span class="topic-count">{count(c.id) ? `${count(c.id)}件の記事` : '記事を準備中'}</span></a></li>)}</ul>
</section>

<section class="section" id="latest" aria-labelledby="latest-title">
<div class="section-title"><div><p class="kicker">LATEST NOTES</p><h2 id="latest-title">新しい、選び方のノート</h2></div><a class="small-link" href="/articles/">すべて読む <span aria-hidden="true">↗</span></a></div>
<div class="grid">{latest.map(article => <ArticleCard article={article} />)}</div>
{!articles.length && <p>記事を準備しています。</p>}
<p class="more"><a class="button button-line" href="/articles/">すべての記事を見る <span aria-hidden="true">→</span></a></p>
</section>
</div>
</Base>
