---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/content';
const featured = articles.find(a => a.slug === 'earphones-first') || articles[0];
const remaining = articles.filter(a => a !== featured);
---
<Base current="home">
<section class="container hero"><h1 class="sr-only">毎日使うものを、ひと息ついて選ぶ。OCHA NOTE</h1><img class="hero-img" src="/hero-1734.webp" srcset="/hero-900.webp 900w, /hero-1734.webp 1734w" sizes="(max-width: 1184px) calc(100vw - 36px), 1120px" width="1734" height="907" alt="" fetchpriority="high" /><p class="hero-lead">ガジェットも、AIも、お土産も、家具も。使う場面から、ちょうどいいものを選ぼう。</p></section>
<section class="container feature-section" aria-label="まず読みたい記事"><div class="section-heading"><span class="eyebrow">START HERE</span><span class="section-note">まず読みたい、選び方の基本</span></div>{featured && <ArticleCard article={featured} featured />}</section>
<section class="container latest"><div class="section-heading"><h2>選び方のノート</h2><span class="section-note">暮らしの場面から探す</span></div><div class="article-grid">{remaining.map(article => <ArticleCard article={article} />)}</div>{!articles.length && <p>記事を準備しています。</p>}</section>
</Base>
