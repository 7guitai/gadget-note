---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, categories } from '../../lib/content';
export function getStaticPaths() { return categories.map(category => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
const posts = articles.filter(a => a.meta.category === category.id);
---
<Base title={category.name} current={category.id} description={`${category.name}の選び方と、購入前に確認したいポイント。`}>
<div class="wrap listing">
<nav class="crumb" aria-label="パンくず"><a href="/">ホーム</a> / {category.name}</nav>
<p class="kicker">{category.short}</p>
<h1 class="page-title">{category.name}</h1>
<p class="listing-lead">{category.desc}。{posts.length ? `${posts.length}件の記事があります。` : ''}</p>
<div class="grid">{posts.map(article => <ArticleCard article={article} level={2} />)}</div>
{posts.length === 0 && <div class="empty"><p>このテーマの記事は準備中です。</p><a class="button button-line" href="/articles/">すべての記事を見る <span aria-hidden="true">→</span></a></div>}
</div>
</Base>
