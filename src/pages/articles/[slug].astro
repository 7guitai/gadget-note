---
import Base from '../../layouts/Base.astro';
import { articles, displayDate, coverVariants, relatedArticles } from '../../lib/content';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
const Content = article.Content;
const headings = (await article.getHeadings()).filter(h => h.depth === 2);
const related = relatedArticles(article);
const v = coverVariants(article.meta.cover);
---
<Base title={article.meta.title} description={article.meta.description} current={article.category.id} image={v?.og} type="article">
<div class="wrap">
<nav class="crumb" aria-label="パンくず"><a href="/">ホーム</a> / <a href={`/category/${article.category.id}/`}>{article.category.name}</a> / {article.meta.kind}</nav>
<div class="article-grid">
<header class="article-head">
<p class="kicker">{article.category.short} / {article.meta.kind}</p>
<h1>{article.meta.title}</h1>
<p class="byline"><span>OCHA NOTE 編集部</span><time datetime={article.meta.date}>公開 {displayDate(article.meta.date)}</time>{article.meta.updated && <time datetime={article.meta.updated}>更新 {displayDate(article.meta.updated)}</time>}</p>
<p class="lead">{article.meta.description}</p>
{article.meta.category === 'ai' && <p class="disclosure">この記事は{displayDate(article.meta.updated ?? article.meta.date)}時点の情報です。AIのサービスは内容や提供状況が変わりやすいため、最新の情報は参照先の公式ページで確認してください。</p>}
{article.meta.affiliate && <p class="disclosure"><strong>PR</strong> この記事には広告（アフィリエイトリンク）が含まれます。リンク先で購入されると、当サイトに報酬が支払われることがあります。</p>}
{v && <figure class="article-cover"><img src={v.src} alt={article.meta.coverAlt} width="1200" height="630" fetchpriority="high" />{article.meta.coverAlt?.includes('イメージ') && <figcaption>画像はイメージです</figcaption>}</figure>}
</header>
{headings.length > 0 && <aside class="toc" aria-labelledby="toc-title"><p id="toc-title" class="toc-title">このノートの目次</p><ol>{headings.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>}
<div class="article-body">
<div class="prose"><Content /></div>
{related.length > 0 && <section class="related" aria-labelledby="related-title"><h2 id="related-title">あわせて読みたい</h2><ul>{related.map(a => <li><a href={`/articles/${a.slug}/`}>{a.meta.title} <span aria-hidden="true">→</span></a></li>)}</ul></section>}
</div>
</div>
</div>
</Base>
