---
import Base from '../../layouts/Base.astro';
import NewsItem from '../../components/NewsItem.astro';
import { news } from '../../lib/news';
---
<Base title="AIニュース" current="news" description="生成AIやAIを使ったサービスの動きを、公式発表をもとに短くまとめます。">
<div class="container listing news-listing"><a class="back-link" href="/">ホーム</a><span class="eyebrow">AI NEWS</span><h1>AIニュース</h1>
<p class="listing-lead">生成AIやAIを使ったサービスの動きを、公式発表をもとに短くまとめます。各記事の日付時点の情報です。</p>
<p class="listing-count">{news.length}件のニュース<a class="rss-link" href="/news/rss.xml">RSS</a></p>
<div class="news-list">{news.map(item => <NewsItem item={item} />)}</div>{!news.length && <p>ニュースを準備しています。</p>}</div>
</Base>
